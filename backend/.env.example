# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# Tried in order when the main model is rate limited, over capacity or slow:
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Optional: illustrate each episode with Cloudflare Workers AI (free daily allowance).
# Account id: Cloudflare dashboard > Workers AI (or the URL dash.cloudflare.com/<account id>).
# Token: My Profile > API Tokens > Create Token > "Workers AI" template.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# GENERATE_IMAGES=true
